# Add inside the EXISTING domain {} block. Keep its TLS settings.
# Use handle, not handle_path: retain /family-trip/ in the upstream request.
@travel path /family-trip /family-trip/*
handle @travel {
    request_body {
        max_size 2KB
    }
    reverse_proxy 127.0.0.1:3100
}
# The app redirects /family-trip to /family-trip/ and preserves any query string.
# Keep the existing site's routes in its existing fallback handle {}.
